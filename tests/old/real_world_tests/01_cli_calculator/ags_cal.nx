// Nox CLI Calculator

if (arg_count == 0) {
    print "Usage: nox calc.nx <flag> <num1> <num2>";
    print "Flags: --add, --sub, --mul, --div";
}

if (arg_count > 0) {
    let flag = get_arg(0);
    
    if (arg_count == 3) {
        let num1 = to_number(get_arg(1));
        let num2 = to_number(get_arg(2));
        
        if (flag == "--add") { print num1 + num2; }
        if (flag == "--sub") { print num1 - num2; }
        if (flag == "--mul") { print num1 * num2; }
        if (flag == "--div") { print num1 / num2; }
    }
    
    if (arg_count < 3) {
        print "Error: Please provide exactly two numbers after the flag.";
    }
}
