// Core I/O & Data Parsing Challenge
// Goal: Read a file, count words, uppercase content, and write to a new file.

fn main() {
    let count = arg_count()
    if (count < 1) {
        print "Usage: nox run main.nx <input_file>"
        return 0
    }

    let inputFile = get_arg(0)
    print "Processing file: " + inputFile

    if (!file_exists(inputFile)) {
        print "Error: File '" + inputFile + "' not found."
        return 1
    }

    let content = read_file(inputFile)
    if (content == null) {
        print "Error: Could not read file."
        return 1
    }

    let words = str_words(content)
    let upper = str_upper(content)

    print "Word count: " + words
    print "Content (Uppercase):"
    print upper

    let outputFile = "out.txt"
    let success = write_file(outputFile, upper)

    if (success) {
        print "Successfully wrote transformed content to " + outputFile
    } else {
        print "Error: Failed to write output file."
    }
}

main()
