// Nox Tic Tac Toe - TUI Edition
// Using Raw ANSI Escapes and Secure Input

let b1 = "1" let b2 = "2" let b3 = "3"
let b4 = "4" let b5 = "5" let b6 = "6"
let b7 = "7" let b8 = "8" let b9 = "9"

let turn = "X"
let winner = "none"
let moves = 0

fn color(mark) {
    if (mark == "X") { return "\e[31mX\e[0m" }
    if (mark == "O") { return "\e[34mO\e[0m" }
    return "\e[90m" + mark + "\e[0m"
}

fn draw_board() {
    print "\e[H\e[J" // Clear screen
    print "\e[1;36m  Nox Tic Tac Toe\e[0m"
    print ""
    print "     " + color(b1) + " | " + color(b2) + " | " + color(b3)
    print "    -----------"
    print "     " + color(b4) + " | " + color(b5) + " | " + color(b6)
    print "    -----------"
    print "     " + color(b7) + " | " + color(b8) + " | " + color(b9)
    print ""
}

fn check_win() {
    // Rows
    if (b1 == b2 && b2 == b3) { winner = b1 }
    if (b4 == b5 && b5 == b6) { winner = b4 }
    if (b7 == b8 && b8 == b9) { winner = b7 }
    // Cols
    if (b1 == b4 && b4 == b7) { winner = b1 }
    if (b2 == b5 && b5 == b8) { winner = b2 }
    if (b3 == b6 && b6 == b9) { winner = b3 }
    // Diagonals
    if (b1 == b5 && b5 == b9) { winner = b1 }
    if (b3 == b5 && b5 == b7) { winner = b3 }
}

fn play() {
    while (winner == "none" && moves < 9) {
        draw_board()
        print " Player " + turn + ", enter move (1-9): "
        let move = read_line()
        
        let valid = 0
        if (move == "1" && b1 == "1") { b1 = turn valid = 1 }
        if (move == "2" && b2 == "2") { b2 = turn valid = 1 }
        if (move == "3" && b3 == "3") { b3 = turn valid = 1 }
        if (move == "4" && b4 == "4") { b4 = turn valid = 1 }
        if (move == "5" && b5 == "5") { b5 = turn valid = 1 }
        if (move == "6" && b6 == "6") { b6 = turn valid = 1 }
        if (move == "7" && b7 == "7") { b7 = turn valid = 1 }
        if (move == "8" && b8 == "8") { b8 = turn valid = 1 }
        if (move == "9" && b9 == "9") { b9 = turn valid = 1 }

        if (valid == 1) {
            moves = moves + 1
            check_win()
            if (turn == "X") { turn = "O" } else { turn = "X" }
        } else {
            print "\e[31mInvalid move! Press Enter to try again...\e[0m"
            read_line()
        }
    }
    
    draw_board()
    if (winner != "none") {
        print "\e[1;32m   CONGRATULATIONS! Player " + winner + " wins!\e[0m"
    } else {
        print "\e[1;33m   It's a DRAW!\e[0m"
    }
}

play()
