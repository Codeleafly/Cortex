
// In standard JS: 1 == 2 < 3  =>  1 == (2 < 3) => 1 == true => 1
// In current Nox: (1 == 2) < 3 => 0 < 3 => 1
// Wait, that example gives same result.

// Let's try: 0 == 1 < 2
// Standard JS: 0 == (1 < 2) => 0 == 1 => 0
// Current Nox: (0 == 1) < 2 => 0 < 2 => 1

print "Testing operator precedence (0 == 1 < 2):";
let result = 0 == 1 < 2;
if (result == 1) {
    print "FAILED: (0 == 1) < 2 was evaluated (Precedence issue)";
} else {
    print "PASSED: 0 == (1 < 2) was evaluated";
}
