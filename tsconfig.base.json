{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@cortex/shared": [
        "packages/shared"
      ],
      "@cortex/frontend": [
        "packages/frontend"
      ],
      "@cortex/runtime": [
        "packages/runtime"
      ]
    }
  }
}
